FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r truss && useradd -r -g truss -s /usr/sbin/nologin truss
COPY --chown=truss:truss truss /truss
COPY THIRD_PARTY_LICENSES.html /usr/share/doc/truss/THIRD_PARTY_LICENSES.html
RUN chmod 0555 /truss
USER truss
EXPOSE 8080
ENTRYPOINT ["/truss", "serve"]
