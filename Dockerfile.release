FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r truss && useradd -r -g truss -s /usr/sbin/nologin truss
COPY --chown=truss:truss truss /truss
COPY THIRD_PARTY_LICENSES.html /usr/share/doc/truss/THIRD_PARTY_LICENSES.html
RUN chmod 0555 /truss
USER truss
EXPOSE 8080
ENTRYPOINT ["/truss", "serve"]
