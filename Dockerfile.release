FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r truss && useradd -r -g truss -s /usr/sbin/nologin truss
COPY --chown=truss:truss truss /truss
COPY THIRD_PARTY_LICENSES.html /usr/share/doc/truss/THIRD_PARTY_LICENSES.html
RUN chmod 0555 /truss
USER truss
EXPOSE 8080
ENTRYPOINT ["/truss", "serve"]
